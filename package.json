{
  "name": "qualm-a11y",
  "version": "2.1.0",
  "description": "Static accessibility linter for React/TypeScript that catches regressions in CI. Render-independent AST analysis: finds WCAG defects in component source with 100% coverage, and fails the build only on new defects via --diff-branch.",
  "bin": {
    "qualm-a11y": "./dist/cli.js"
  },
  "main": "./dist/analyser.js",
  "types": "./dist/types.d.ts",
  "files": [
    "dist",
    "README.md",
    "METHODOLOGY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build && npm test && node dist/cli.js --version"
  },
  "dependencies": {
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/typescript-estree": "^7.0.0",
    "@typescript-eslint/utils": "^7.0.0",
    "chalk": "^4.1.2",
    "commander": "^12.0.0",
    "glob": "^10.0.0",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "static-analysis",
    "linter",
    "react",
    "typescript",
    "ast",
    "ci",
    "sarif",
    "code-quality"
  ],
  "license": "MIT",
  "author": "Somil Sharma <iamsomilsharma@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/SomilKSharma/qualm.git"
  },
  "homepage": "https://github.com/SomilKSharma/qualm#readme",
  "bugs": {
    "url": "https://github.com/SomilKSharma/qualm/issues"
  }
}
